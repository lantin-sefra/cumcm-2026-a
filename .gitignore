# 告诉 Git：下面这些文件不要上传到网上。
# Git 是装在电脑上的版本记录工具；GitHub 是网上存放处。

# 中间产物与本机 TeX 安装（体积巨大，绝不能上传）
workspace/_tmp/

# Python 运行缓存与虚拟环境
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.venv/
venv/
env/

# 密钥与本地环境变量（若以后有 API 密钥，放这里就不会被上传）
.env
.env.*
!.env.example

# 系统垃圾文件
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# 编辑器/AI 本地状态（可能含本机路径或密钥）
.cursor/
*.swp
*~

# LaTeX 编译过程文件（保留 .tex / .bib / .pdf，只忽略编译渣）
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.xdv
*.bbl
*.blg
*.nav
*.snm
*.vrb

# 误生成的打包文件
*.tmp
*.bak
